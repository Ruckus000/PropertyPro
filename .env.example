# =============================================================================
# PropertyPro Florida — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE
#    Get these from: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Database (Project Settings → Database)
# Pooled connection (port 6543) — used by the app at runtime
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Direct connection (port 5432) — used ONLY for migrations
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# 2. STRIPE
#    Get these from: Stripe Dashboard → Developers → API keys
#    Webhook secret: Developers → Webhooks → your endpoint → Signing secret
#    (Can defer to Phase 2)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price IDs — one per plan (Stripe Dashboard → Products → Price ID)
# Env key format: STRIPE_PRICE_<PLAN_ID_UPPERCASED> (see apps/web/src/lib/services/stripe-service.ts)
# Plan IDs: compliance_basic, compliance_plus_mobile, full_platform, apartment_operations
STRIPE_PRICE_COMPLIANCE_BASIC=price_...
STRIPE_PRICE_COMPLIANCE_PLUS_MOBILE=price_...
STRIPE_PRICE_FULL_PLATFORM=price_...
STRIPE_PRICE_APARTMENT_OPERATIONS=price_...
# Stripe Connect OAuth (Standard accounts — Phase 1A)
# Get from: Stripe Dashboard → Settings → Connect → Platform settings → Client ID
STRIPE_CONNECT_CLIENT_ID=ca_...

# -----------------------------------------------------------------------------
# 3. RESEND
#    Get these from: Resend Dashboard → API Keys
#    Domains: Resend Dashboard → Domains (verify getpropertypro.com; sender must use that domain)
#    (Can defer to Phase 1)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
# Optional — overrides default sender (PropertyPro <noreply@getpropertypro.com>)
# RESEND_FROM=PropertyPro <noreply@getpropertypro.com>

# Set to 1 to suppress ALL outbound mail. Messages are collected and logged
# (envelope only — recipient, subject, category; never the rendered body) rather
# than transmitted, so you can see who a job would have mailed before it does.
# Outranks RESEND_API_KEY, so a live key cannot defeat it.
#
# Both env wrappers set this for you: with-env-local-demo-db.sh forces it on (a
# local database has no business mailing anyone), and with-env-local.sh defaults
# it on because it targets the production database — pass
# PROPERTYPRO_ALLOW_OUTBOUND_MAIL=1 there when you genuinely mean to deliver.
# EMAIL_DRY_RUN=1

# -----------------------------------------------------------------------------
# 4. SENTRY
#    Get these from: Sentry → Project Settings → Client Keys (DSN)
#    Auth token: Sentry → Settings → Auth Tokens
# -----------------------------------------------------------------------------
# Client-side DSN (exposed to browser)
NEXT_PUBLIC_SENTRY_DSN=
# Server-side DSN
SENTRY_DSN=
# Source map upload token (only needed for production builds)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Admin app only. If unset, apps/admin/next.config.ts falls back to SENTRY_PROJECT
# and admin's errors + source maps land in the WEB project.
SENTRY_PROJECT_ADMIN=

# -----------------------------------------------------------------------------
# 5. UPSTASH REDIS
#    Get these from: Upstash Console → Your Database → REST API
#    (Can defer to Phase 2)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# -----------------------------------------------------------------------------
# 6. APP CONFIG
# -----------------------------------------------------------------------------
# Base URL for links generated on the server. `getBaseUrl()` reads this, and
# nearly all of its ~26 callers put the result in an OUTBOUND EMAIL (invitations,
# password reset, signup verification, digests, broadcasts, payment alerts).
#
# localhost is correct here for `next dev`. It is NOT correct for an ops script
# run against production — `scripts/with-env-local.sh` points at the production
# database, so it overrides this to the production app URL and refuses to run if
# it still resolves to localhost. Vercel sets its own value per environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Admin app origin for CSP frame-ancestors when preview iframes are used.
# Default: http://localhost:3001 (dev) / https://admin.getpropertypro.com (prod)
# Override if admin is hosted at a custom domain.
ADMIN_ORIGIN=

# Admin app only. Where the demo -> paid conversion flow returns the customer
# after Stripe checkout. Read by apps/admin .../demos/[id]/convert.
WEB_APP_BASE_URL=
# Cookie domain for cross-subdomain session sharing.
# Set to .getpropertypro.com in production. Leave empty for localhost dev.
# Do NOT set on Vercel preview deploys (cookies should scope to preview hostname).
NEXT_PUBLIC_COOKIE_DOMAIN=

# --- Custom domains (Phase 2, Pro+) ---
# Vercel Domains API. Canonical Vercel CLI names; VERCEL_ORG_ID is team-scoped
# (team_…) so Domains API calls pass ?teamId=$VERCEL_ORG_ID.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
# Bare host (NO scheme, NO trailing slash). Base-domain discriminator for
# custom-domain routing + own-domain blocklist. Dev: localhost:3000.
NEXT_PUBLIC_ROOT_DOMAIN=getpropertypro.com

# Do NOT set NODE_ENV in .env.local. `next dev`, `next build`, and `vitest`
# each pick the correct value. Forcing `NODE_ENV=development` into
# `next build` breaks prerender of `/_error: /404`: Next's
# `pages.runtime.dev.js` and `pages.runtime.prod.js` ship different
# `HtmlContext` instances, so the Pages-Router `<Html>` consumer reads a
# different context than the render Provider. scripts/with-env-local.sh
# also unsets NODE_ENV defensively.

# Required by scripts/seed-demo.ts and scripts/reset-demo.ts.
# Allowed: development | ci | demo-nightly. Unset = refuse to run.
# The CLI refuses to touch a DB without this set to an allowed value.
PROPERTYPRO_SEED_ENV=development

# -----------------------------------------------------------------------------
# 7. INTERNAL CRON AUTH
# -----------------------------------------------------------------------------
# GitHub Actions cron job base URL (production deployment URL)
# Used by: .github/workflows/notification-digest-cron.yml
# This should be your Vercel production URL (e.g., https://property-pro-xyz.vercel.app)
# NOTE: This is configured as a GitHub repository secret, not in this .env file
DIGEST_CRON_BASE_URL=https://your-production-url.vercel.app

# THE ONE THAT MATTERS: Vercel Cron authenticates every scheduled job with
# `Authorization: Bearer $CRON_SECRET`, and sends NO header at all when this is
# unset — so every job 401s while the dashboard still shows the cron registered
# and firing. All 10 jobs were dead in production for months this way.
#
# Every /api/v1/internal/* route accepts this as a fallback, so it is the only
# cron secret you actually need. The per-route secrets below remain supported as
# overrides but are no longer required.
CRON_SECRET=change-me

# Shared bearer secret used by scheduler calls to:
# GET /api/v1/internal/readiness
READINESS_CHECK_SECRET=change-me
# POST /api/v1/internal/notification-digests/process
NOTIFICATION_DIGEST_CRON_SECRET=change-me
# POST /api/v1/internal/payment-reminders
PAYMENT_REMINDERS_CRON_SECRET=change-me
DEMO_EXPIRY_CRON_SECRET=change-me
# POST /api/v1/internal/coupon-sync-retry
COUPON_SYNC_RETRY_CRON_SECRET=change-me
# POST /api/v1/internal/assessment-overdue
# POST /api/v1/internal/late-fee-processor
# POST /api/v1/internal/generate-assessments
ASSESSMENT_CRON_SECRET=change-me
# POST /api/v1/internal/provision (manual provisioning retry for platform admin)
PROVISIONING_RETRY_SECRET=change-me
COMPLIANCE_CRON_SECRET=change-me
VISITOR_AUTO_CHECKOUT_CRON_SECRET=change-me
# POST /api/v1/internal/revenue-snapshot
REVENUE_SNAPSHOT_CRON_SECRET=
# POST /api/v1/internal/account-lifecycle
ACCOUNT_LIFECYCLE_CRON_SECRET=
# GET  /api/v1/internal/calendar-event-reminders
CALENDAR_EVENT_REMINDERS_CRON_SECRET=
# GET  /api/v1/internal/scheduled-site-publish
SCHEDULED_SITE_PUBLISH_CRON_SECRET=
# GET  /api/v1/internal/community-export-worker
COMMUNITY_EXPORT_CRON_SECRET=
# GET  /api/v1/internal/insurance-alerts
INSURANCE_ALERTS_CRON_SECRET=
# GET  /api/v1/internal/snowbird-digest
SNOWBIRD_DIGEST_CRON_SECRET=

# -----------------------------------------------------------------------------
# 8. DEMO SEED DATA
# -----------------------------------------------------------------------------
# AES-256-GCM key for demo token-secret encryption at rest.
# Generate with: openssl rand -hex 32
DEMO_TOKEN_ENCRYPTION_KEY_HEX=

# Used by `pnpm seed:demo` to create/update demo authentication users.
# Demo emails are defined in scripts/config/demo-data.ts.
DEMO_DEFAULT_PASSWORD=DemoPass123!

# Dev auto-login shortcuts (development only, ignored in production)
# Usage: GET /dev/login?as=owner
# Valid roles: owner, tenant, board_president, board_member, cam, pm_admin, site_manager
DEV_LOGIN_OWNER_EMAIL=owner.one@sunset.local
DEV_LOGIN_TENANT_EMAIL=tenant.one@sunset.local
DEV_LOGIN_BOARD_PRESIDENT_EMAIL=board.president@sunset.local
DEV_LOGIN_BOARD_MEMBER_EMAIL=board.member@sunset.local
DEV_LOGIN_CAM_EMAIL=cam.one@sunset.local
DEV_LOGIN_PM_ADMIN_EMAIL=pm.admin@sunset.local
DEV_LOGIN_SITE_MANAGER_EMAIL=site.manager@sunsetridge.local

# -----------------------------------------------------------------------------
# 9. TWILIO (Phase 1B — Emergency SMS Notifications)
#    Get these from: Twilio Console → Account Info (SID + Auth Token)
#    Messaging Service: Twilio Console → Messaging → Services
#    Verify Service: Twilio Console → Verify → Services
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=MG...
TWILIO_VERIFY_SERVICE_SID=VA...

# -----------------------------------------------------------------------------
# 10. OAUTH TOKEN ENCRYPTION (WS-70)
# -----------------------------------------------------------------------------
# AES-256-GCM key for calendar/accounting OAuth tokens.
# Required for WS-70 connector routes in non-test environments.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# HMAC key for access-request OTPs. REQUIRED — hashOtp() throws without it.
# There is deliberately no fallback: OTPs are six digits, so this secret is the
# only thing preventing a leaked hash column from being reversed instantly.
# Generate with: openssl rand -hex 32
OTP_HMAC_SECRET=

# HMAC secret for the OAuth `state` parameter on calendar and accounting
# connectors. REQUIRED — signOAuthState() throws without it, so "Connect Google
# Calendar" 500s rather than degrading. Reported by /api/v1/internal/readiness.
# Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=

# Signing secret for short-lived re-authentication tokens (min 32 chars).
# REQUIRED — without it the billing portal and account deletion 500 from the
# user's point of view, with nothing in the UI explaining why. Reported by
# /api/v1/internal/readiness.
# Generate with: openssl rand -hex 32
REAUTH_JWT_SECRET=

# -----------------------------------------------------------------------------
# 11. SUPPORT SESSION JWT (Support Access)
# -----------------------------------------------------------------------------
# HMAC secret for signing support impersonation JWTs (min 32 chars).
# Generate with: openssl rand -hex 32
#
# REQUIRED in EVERY environment — there is no development fallback. The admin
# app signs the token and the web app verifies it, so the SAME value must be
# set on BOTH Vercel projects (property-pro-admin and property-pro-web) for
# production, preview and development.
#
# Without it, support access fails closed: the admin app refuses to mint a
# token (500 SERVER_MISCONFIGURED) and the web app rejects every support
# cookie. That is deliberate. Until 2026-08-05 both sides fell back to a
# constant checked into the repo whenever NODE_ENV !== 'production', which made
# the token forgeable by anyone with a checkout.
#
# apps/web/e2e/support-access.spec.ts exercises the real signer and verifier,
# so this must be present in .env.local for that spec to pass.
SUPPORT_SESSION_JWT_SECRET=

# -----------------------------------------------------------------------------
# 12. FEATURE FLAGS
# -----------------------------------------------------------------------------
# Phase A rollout of the help-docs modal (see docs/superpowers/specs/2026-05-20-help-docs-modal-design.md)
NEXT_PUBLIC_HELP_DOCS_MODAL_ENABLED=false

# -----------------------------------------------------------------------------
# 13. EMAIL UNSUBSCRIBE SIGNING
# -----------------------------------------------------------------------------
# HMAC secrets for the signed, no-login unsubscribe links carried by bulk email.
#
# These fail QUIETLY and that is the whole problem. The signers return `null`
# rather than throwing when the secret is unset — deliberate, because throwing
# would take every announcement for every association down over a config
# mistake. The mail still sends; it just carries a login-walled settings URL
# instead of a working one-click link.
#
# That silently breaks RFC 8058 one-click unsubscribe and CAN-SPAM's
# no-account-required expectation, and it is invisible from the outside: the
# send succeeds, the dashboard is green, and the only symptom is spam
# complaints from recipients who could not unsubscribe. Gmail and Yahoo bulk
# sender rules make that a deliverability problem, not just a legal one.
#
# /api/v1/internal/readiness reports all three, so an unset value shows up as
# `degraded` instead of never showing up at all.
# Generate each with: openssl rand -hex 32
#
# ⚠️ Setting these in Vercel: use `vercel env add … --no-sensitive`.
# `vercel env add` marks a variable Sensitive by DEFAULT, `vercel pull` then
# writes it back as the literal string `[SENSITIVE]`, and deploy.yml runs
# pull-then-build — so the deployed key becomes a publicly-known constant and
# anyone can forge an unsubscribe token for any recipient. That is worse than
# leaving it unset. Full explanation in docs/DEPLOYMENT.md §4.1; the same
# applies to every secret in this file.
COMMUNITY_EMAIL_UNSUBSCRIBE_SECRET=
SNOWBIRD_UNSUBSCRIBE_SECRET=
INSURANCE_ALERTS_UNSUBSCRIBE_SECRET=
