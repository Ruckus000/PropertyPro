{
  "section": "manager",
  "category": "leases",
  "slug": "upcoming-lease",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "shots": [
    {
      "name": "step-1",
      "kind": "still",
      "route": "/dashboard/leases?communityId={cid}",
      "role": "site_manager",
      "actions": [
        {
          "type": "waitFor",
          "selector": "[aria-label=\"Filter units\"]"
        },
        {
          "type": "click",
          "selector": "button[aria-label=\"New lease, Unit 305\"]"
        },
        {
          "type": "waitFor",
          "selector": "[role=\"dialog\"]:has(h2:has-text(\"New lease\"))"
        },
        {
          "type": "wait",
          "ms": 300
        },
        {
          "type": "fill",
          "selector": "#lf-residents",
          "value": "a"
        },
        {
          "type": "waitFor",
          "selector": "#lf-residents-list"
        },
        {
          "type": "click",
          "selector": "#lf-residents-list [role=\"option\"]"
        },
        {
          "type": "fill",
          "selector": "#lf-rent",
          "value": "1400"
        },
        {
          "type": "click",
          "selector": "[role=\"dialog\"]:has(h2:text-is(\"New lease\")) button[type=\"submit\"]"
        },
        {
          "type": "waitFor",
          "selector": "[data-sonner-toast]"
        },
        {
          "type": "wait",
          "ms": 1500
        }
      ],
      "clipTo": "tr:has(button[aria-label=\"Open Unit 305\"])",
      "community": "apartment"
    },
