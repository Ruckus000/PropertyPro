{
  "section": "manager",
  "category": "residents",
  "slug": "join-requests",
  "shots": [
    {
      "name": "jr-queue",
      "kind": "still",
      "route": "/dashboard/directory?tab=requests&communityId={cid}",
      "role": "cam",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "role=button[name=\"Approve\"]"
        }
      ],
      "clipTo": "role=tabpanel",
      "highlight": "role=tabpanel >> text=On your roster",
      "step": 1
    },
    {
      "name": "jr-deny",
      "kind": "still",
      "route": "/dashboard/directory?tab=requests&communityId={cid}",
      "role": "cam",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "role=button[name=\"Deny\"]"
        },
        {
          "type": "click",
          "selector": "role=button[name=\"Deny\"] >> nth=0"
        },
        {
          "type": "fill",
          "selector": "textarea[id^=\"deny-notes-\"]",
          "value": "The unit number does not match our records; please check your closing papers and resubmit."
        }
      ],
      "clipTo": "role=tabpanel",
      "highlight": "textarea[id^=\"deny-notes-\"]",
      "step": 3
    }
  ]
}
