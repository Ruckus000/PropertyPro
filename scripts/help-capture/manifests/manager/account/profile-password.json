{
  "section": "manager",
  "category": "account",
  "slug": "profile-password",
  "shots": [
    {
      "name": "acc-profile",
      "kind": "still",
      "route": "/settings/account?communityId={cid}",
      "role": "cam",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "role=textbox[name=\"Full Name\"]"
        }
      ],
      "clipTo": [
        "role=heading[name=\"Profile\"s]",
        "role=button[name=\"Save Changes\"s]"
      ],
      "highlight": "role=textbox[name=\"Full Name\"]",
      "step": 2
    },
    {
      "name": "acc-save",
      "kind": "still",
      "route": "/settings/account?communityId={cid}",
      "role": "cam",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "role=textbox[name=/Phone/]"
        },
        {
          "type": "fill",
          "selector": "role=textbox[name=/Phone/]",
          "value": "(305) 555-0199"
        }
      ],
      "clipTo": [
        "role=heading[name=\"Profile\"s]",
        "role=button[name=\"Save Changes\"s]"
      ],
      "highlight": "role=button[name=\"Save Changes\"s]",
      "step": 3
    },
    {
      "name": "acc-pw",
      "kind": "still",
      "route": "/settings/account?communityId={cid}",
      "role": "cam",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "role=heading[name=\"Password\"s]"
        },
        {
          "type": "scrollTo",
          "selector": "role=heading[name=\"Password\"s]"
        }
      ],
      "clipTo": [
        "role=heading[name=\"Password\"s]",
        "role=button[name=\"Update Password\"s]"
      ]
    }
  ]
}
