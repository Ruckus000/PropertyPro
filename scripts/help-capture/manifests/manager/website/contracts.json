{
  "section": "manager",
  "category": "website",
  "slug": "contracts",
  "shots": [
    {
      "name": "ct-alerts",
      "kind": "still",
      "route": "/contracts?communityId={cid}",
      "role": "cam",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "role=heading[name=\"Expiration Alerts\"]"
        }
      ],
      "clipTo": "section:has(h2:text-is(\"Expiration Alerts\"))"
    },
    {
      "name": "ct-add",
      "kind": "still",
      "route": "/contracts?communityId={cid}",
      "role": "cam",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "role=link[name=\"Add contract\"]"
        }
      ],
      "clipTo": "role=link[name=\"Add contract\"]",
      "pad": 48,
      "highlight": "role=link[name=\"Add contract\"]",
      "step": 1
    },
    {
      "name": "ct-form",
      "kind": "still",
      "route": "/contracts/new?communityId={cid}",
      "role": "cam",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "#contract-title"
        }
      ],
      "clipTo": "form:has(#contract-title)",
      "highlight": "#contract-title",
      "step": 2
    },
    {
      "name": "ct-bids",
      "kind": "still",
      "route": "/contracts?communityId={cid}",
      "role": "cam",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "role=table[name=\"Contracts\"] >> role=link >> nth=0"
        },
        {
          "type": "click",
          "selector": "role=table[name=\"Contracts\"] >> role=link >> nth=0"
        },
        {
          "type": "waitFor",
          "selector": "role=heading[name=\"Bids\"]"
        },
        {
          "type": "waitFor",
          "selector": "role=button[name=\"Add bid\"]"
        }
      ],
      "clipTo": "section:has(h2:text-is(\"Bids\"))"
    }
  ]
}
