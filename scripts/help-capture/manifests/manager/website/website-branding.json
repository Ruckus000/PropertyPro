{
  "section": "manager",
  "category": "website",
  "slug": "website-branding",
  "viewport": {
    "width": 1440,
    "height": 1700
  },
  "shots": [
    {
      "name": "wb-colors",
      "kind": "still",
      "route": "/pm/website-editor?communityId={cid}",
      "role": "cam",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "[data-testid=\"site-editor-tool-design\"]"
        },
        {
          "type": "click",
          "selector": "[data-testid=\"site-editor-tool-design\"]"
        },
        {
          "type": "waitFor",
          "selector": "role=button[name=/Save colours/]"
        },
        {
          "type": "scrollTo",
          "selector": "#design-custom-heading"
        }
      ],
      "clipTo": [
        "section[aria-labelledby=\"design-custom-heading\"]"
      ],
      "highlight": "#design-custom-heading",
      "step": 1
    },
    {
      "name": "wb-domain",
      "kind": "still",
      "route": "/pm/website-editor?communityId={cid}",
      "role": "cam",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "[data-testid=\"editor-view-settings\"]"
        },
        {
          "type": "click",
          "selector": "[data-testid=\"editor-view-settings\"]"
        },
        {
          "type": "click",
          "selector": "role=tab[name=\"Address & domain\"]"
        },
        {
          "type": "waitFor",
          "selector": "role=textbox[name=\"Your domain\"]"
        }
      ],
      "clipTo": [
        "#settings-panel-address > div:has(> h3:text-is(\"Use your own domain\"))"
      ],
      "highlight": "role=textbox[name=\"Your domain\"]",
      "step": 2
    }
  ]
}
