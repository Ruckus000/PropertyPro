      "step": 1
    },
    {
      "name": "wb-domain",
      "kind": "still",
      "route": "/pm/website?communityId={cid}&tab=settings",
      "role": "cam",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "role=textbox[name=\"Your domain\"]"
        },
        {
          "type": "scrollTo",
          "selector": "role=textbox[name=\"Your domain\"]"
        }
      ],
      "clipTo": [
        "[data-testid=\"live-site-settings\"] > div:has(> h3:text-is(\"Use your own domain\"))"
