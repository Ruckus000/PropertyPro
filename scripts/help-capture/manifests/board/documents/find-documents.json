{
  "section": "board",
  "category": "documents",
  "slug": "find-documents",
  "shots": [
    {
      "name": "doc-cats",
      "kind": "still",
      "route": "/communities/{cid}/documents",
      "role": "owner",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "role=button[name=\"Governing Documents\"]"
        }
      ],
      "clipTo": "role=button[name=\"All\"s] >> xpath=..",
      "highlight": "role=button[name=\"Governing Documents\"]",
      "step": 1
    },
    {
      "name": "doc-search",
      "kind": "still",
      "route": "/communities/{cid}/documents",
      "role": "owner",
      "community": "condo",
      "actions": [
        {
          "type": "click",
          "selector": "role=button[name=\"Search\"s]"
        },
        {
          "type": "fill",
          "selector": "input[placeholder=\"Search documents\"]",
          "value": "bud"
        },
        {
          "type": "click",
          "selector": "role=button[name=\"Search\"s]"
        },
        {
          "type": "waitFor",
          "selector": "section:has(input[placeholder=\"Search documents\"]) li"
        }
      ],
      "clipTo": "section:has(input[placeholder=\"Search documents\"])",
      "highlight": "input[placeholder=\"Search documents\"]",
      "step": 2
    },
    {
      "name": "doc-row",
      "kind": "still",
      "route": "/communities/{cid}/documents",
      "role": "owner",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "role=button[name=/^Annual Budget/]"
        }
      ],
      "clipTo": "tr:has-text(\"Annual Budget\")",
      "highlight": "role=button[name=/^Annual Budget/]",
      "step": 3
    },
    {
      "name": "doc-dl",
      "kind": "still",
      "route": "/communities/{cid}/documents",
      "role": "owner",
      "community": "condo",
      "actions": [
        {
          "type": "click",
          "selector": "role=button[name=/^Annual Budget/]"
        },
        {
          "type": "waitFor",
          "selector": "role=button[name=\"Download\"s]"
        }
      ],
      "clipTo": "role=button[name=\"Download\"s] >> xpath=..",
      "highlight": "role=button[name=\"Download\"s]",
      "step": 4
    },
    {
      "name": "doc-viewer",
      "kind": "still",
      "route": "/communities/{cid}/documents",
      "role": "owner",
      "community": "condo",
      "actions": [
        {
          "type": "click",
          "selector": "role=button[name=/^Annual Budget/]"
        },
        {
          "type": "waitFor",
          "selector": "role=button[name=\"Version History\"]"
        },
        {
          "type": "wait",
          "ms": 2000
        }
      ],
      "clipTo": "div.h-full.flex-col.rounded-md:has(h3)"
    }
  ]
}
