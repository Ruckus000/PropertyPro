{
  "section": "board",
  "category": "maintenance",
  "slug": "maintenance-request",
  "shots": [
    {
      "name": "mr-submit",
      "kind": "still",
      "route": "/communities/{cid}/operations?tab=requests",
      "role": "owner",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "role=button[name=\"Submit Request\"]"
        }
      ],
      "clipTo": [
        "h1:text-is(\"Operations\")",
        "role=button[name=\"Submit Request\"] >> nth=0"
      ],
      "highlight": "role=button[name=\"Submit Request\"] >> nth=0",
      "step": 1
    },
    {
      "name": "mr-cat",
