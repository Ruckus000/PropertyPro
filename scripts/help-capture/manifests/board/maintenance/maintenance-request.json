      "route": "/communities/{cid}/operations?tab=requests&create=request",
      "role": "owner",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "#mr-title"
        },
        {
          "type": "fill",
          "selector": "#mr-title",
          "value": "Kitchen sink leak"
        },
        {
          "type": "fill",
          "selector": "#mr-unit-label",
          "value": "4B"
        }
