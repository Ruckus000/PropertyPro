{
  "category": "apartment",
  "slug": "expiry-alert-windows",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "shots": [
    {
      "name": "step-1",
      "kind": "still",
      "route": "/dashboard/leases?communityId=3",
      "role": "root_sunsetridge",
      "actions": [
        {
          "type": "waitFor",
          "selector": "[aria-label=\"Filter units\"]"
        }
      ],
      "clipTo": "section[aria-labelledby=\"roster-title\"] > div:first-child"
    },
    {
      "name": "step-2",
      "kind": "still",
      "route": "/dashboard/leases?communityId=3",
      "role": "root_sunsetridge",
      "actions": [
        {
          "type": "waitFor",
          "selector": "[aria-label=\"Filter units\"]"
        },
        {
          "type": "click",
          "selector": "button:has-text(\"Expiry alerts:\")"
        },
        {
          "type": "waitFor",
          "selector": "[role=\"menu\"]"
        }
      ],
      "clipTo": "[role=\"menu\"]"
    },
    {
      "name": "step-3",
      "kind": "still",
      "route": "/dashboard/leases?communityId=3",
      "role": "root_sunsetridge",
      "actions": [
        {
          "type": "waitFor",
          "selector": "[aria-label=\"Filter units\"]"
        },
        {
          "type": "click",
          "selector": "button:has-text(\"Expiry alerts:\")"
        },
        {
          "type": "waitFor",
          "selector": "[role=\"menu\"]"
        },
        {
          "type": "click",
          "selector": "[role=\"menuitemradio\"]:has-text(\"60, 90, 120 days\")"
        },
        {
          "type": "waitFor",
          "selector": "[data-sonner-toast]"
        },
        {
          "type": "wait",
          "ms": 1200
        }
      ],
      "clipTo": "[aria-label=\"Filter units\"]"
    }
  ]
}
