{
  "section": "resident",
  "category": "getting-started",
  "slug": "your-dashboard",
  "shots": [
    {
      "name": "dash-r",
      "kind": "still",
      "route": "/dashboard?communityId={cid}",
      "role": "owner",
      "community": "condo",
      "actions": [
        {
          "type": "waitFor",
          "selector": "role=heading[name=\"This week\"]"
        },
        {
          "type": "scrollTo",
          "selector": "section[aria-labelledby=\"this-week-heading\"]"
        }
      ],
      "clipTo": [
        "main section:has(> h2.font-display)",
        "section[aria-labelledby=\"this-week-heading\"]"
      ]
    },
    {
      "name": "dash-board",
      "kind": "still",
