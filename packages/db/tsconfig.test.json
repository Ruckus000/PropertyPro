{
  // Type-checks packages/db's tests, which tsconfig.json (src only) never
  // covered — errors in __tests__ went unseen. Run by this package's
  // `typecheck` script, so turbo and CI's Typecheck job include it.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The seed tests pull in scripts/ and apps/web/src; nothing is emitted,
    // so widen rootDir to the repo instead of ".." (packages/).
    "rootDir": "../..",
    // `paths` REPLACES the inherited map, so restate the root's and add `@/*`:
    // the seed/reset tests import scripts/seed-demo.ts, which reaches apps/web
    // services written against that alias (same as scripts/tsconfig.json).
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@propertypro/api-contract": ["packages/api-contract/src"],
      "@propertypro/api-contract/*": ["packages/api-contract/src/*"],
      "@propertypro/db": ["packages/db/src"],
      "@propertypro/db/*": ["packages/db/src/*"],
      "@propertypro/email": ["packages/email/src"],
      "@propertypro/email/*": ["packages/email/src/*"],
      "@propertypro/shared": ["packages/shared/src"],
      "@propertypro/shared/*": ["packages/shared/src/*"],
      "@propertypro/theme": ["packages/theme/src"],
      "@propertypro/theme/*": ["packages/theme/src/*"],
      "@propertypro/tokens": ["packages/tokens/src"],
      "@propertypro/tokens/*": ["packages/tokens/src/*"],
      "@propertypro/ui": ["packages/ui/src"],
      "@propertypro/ui/*": ["packages/ui/src/*"]
    }
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts"],
  // Known-red when this project was added (2026-10-05): 53 pre-existing errors
  // across these 10 files. SHRINK THIS LIST; never add to it to hide a new
  // error. A new test file is type-checked by default.
  "exclude": [
    "__tests__/audit-logging.test.ts",
    "__tests__/document-access.integration.test.ts",
    "__tests__/documents-tenant-isolation.integration.test.ts",
    "__tests__/keyset-indexes-migration.test.ts",
    "__tests__/pagination.integration.test.ts",
    "__tests__/pipeline-and-transactions.integration.test.ts",
    "__tests__/rls-policies.integration.test.ts",
    "__tests__/scoped-client.integration.test.ts",
    "__tests__/support-inbox-migration.test.ts",
    "__tests__/token-encryption.test.ts"
  ]
}
