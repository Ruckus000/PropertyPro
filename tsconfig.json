{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "allowJs": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@propertypro/api-contract": ["packages/api-contract/src"],
      "@propertypro/api-contract/*": ["packages/api-contract/src/*"],
      "@propertypro/db": ["packages/db/src"],
      "@propertypro/db/*": ["packages/db/src/*"],
      "@propertypro/email": ["packages/email/src"],
      "@propertypro/email/*": ["packages/email/src/*"],
      "@propertypro/shared": ["packages/shared/src"],
      "@propertypro/shared/*": ["packages/shared/src/*"],
      "@propertypro/theme": ["packages/theme/src"],
      "@propertypro/theme/*": ["packages/theme/src/*"],
      "@propertypro/tokens": ["packages/tokens/src"],
      "@propertypro/tokens/*": ["packages/tokens/src/*"],
      "@propertypro/ui": ["packages/ui/src"],
      "@propertypro/ui/*": ["packages/ui/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo"],
  "references": [
    { "path": "apps/web" },
    { "path": "apps/admin" },
    { "path": "packages/api-contract" },
    { "path": "packages/db" },
    { "path": "packages/shared" },
    { "path": "packages/ui" },
    { "path": "packages/email" },
    { "path": "packages/theme" },
    { "path": "packages/tokens" }
  ],
  "files": []
}
