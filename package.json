{
  "name": "propertypro",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "setup": "./scripts/setup.sh",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "new:resource": "tsx scripts/scaffold-resource.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "reset:demo": "tsx scripts/reset-demo.ts",
    "seed:verify": "tsx scripts/verify-seed-evidence.ts",
    "address-index:build": "tsx scripts/address-index/build.ts",
    "plan:verify:phase2": "tsx scripts/verify-phase2-plan-status.ts",
    "plan:verify:phase3": "tsx scripts/verify-phase3-plan-status.ts",
    "plan:verify:phase4": "tsx scripts/verify-phase4-plan-status.ts",
    "perf:check": "tsx scripts/perf-check.ts",
    "lint:docs": "tsx scripts/lint-documentation.ts",
    "test:integration:preflight": "pnpm --filter @propertypro/db db:migrate && pnpm seed:verify && pnpm --filter @propertypro/db test:integration && pnpm exec vitest run --config apps/web/vitest.integration.config.ts",
    "test:tenant-isolation-game-day": "pnpm exec vitest run --config apps/web/vitest.integration.config.ts apps/web/__tests__/integration/tenant-isolation-game-day.integration.test.ts",
    "playwright:install": "pnpm --filter @propertypro/web playwright:install",
    "test:e2e": "pnpm --filter @propertypro/web test:e2e",
    "test:e2e:esign": "pnpm --filter @propertypro/web test:e2e -- e2e/esign-and-documents-flow.spec.ts",
    "test:e2e:headed": "pnpm --filter @propertypro/web test:e2e:headed",
    "test:e2e:tenant": "pnpm --filter @propertypro/web test:e2e:tenant",
    "test:watch": "vitest",
    "guard:db-access": "tsx scripts/verify-scoped-db-access.ts",
    "guard:token-freshness": "tsx scripts/verify-token-freshness.ts",
    "guard:breadcrumbs": "tsx scripts/verify-page-breadcrumbs.ts",
    "guard:operations-routes": "tsx --tsconfig apps/web/tsconfig.json scripts/verify-operations-routes.ts",
    "guard:sentry-instrumentation": "tsx scripts/verify-sentry-instrumentation.ts",
    "guard:component-api-calls": "tsx scripts/verify-component-api-calls.ts",
    "guard:authz-comments": "tsx scripts/verify-authz-comments.ts",
    "guard:component-service-imports": "tsx scripts/verify-component-service-imports.ts",
    "guard:route-table-imports": "tsx scripts/verify-route-table-imports.ts",
    "guard:contracts": "tsx scripts/verify-contracts.ts",
    "guard:help-content": "tsx --tsconfig apps/web/tsconfig.json scripts/verify-help-content.ts",
    "help:preview": "tsx --tsconfig apps/web/tsconfig.json scripts/help-content-preview.ts",
    "help:gaps-report": "tsx --tsconfig apps/web/tsconfig.json scripts/help-content-gaps-report.ts",
    "lint": "turbo run lint && pnpm guard:db-access && pnpm guard:token-freshness && pnpm guard:breadcrumbs && pnpm guard:operations-routes && pnpm guard:sentry-instrumentation && pnpm guard:component-api-calls && pnpm guard:authz-comments && pnpm guard:component-service-imports && pnpm guard:route-table-imports && pnpm guard:contracts && pnpm guard:help-content",
    "clean": "turbo run clean"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "isomorphic-dompurify>jsdom": "25.0.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@propertypro/db": "workspace:*",
    "@vitest/coverage-v8": "^3.0.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.58.2",
    "postgres": "^3.4.8",
    "stripe": "^20.3.1",
    "tsx": "^4.21.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
