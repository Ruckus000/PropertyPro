.codex-*/
.knee/
.claude/patches/
.claude/plans/
# Ignore skill contents (not the dir itself) so the one committed project
# skill below can be re-included — git can't un-ignore a file whose parent
# DIR is ignored, but it can when only the dir's contents are.
.claude/skills/*
!.claude/skills/drain-loop.md
.claude/start-*.sh
.claude/scheduled_tasks.lock
.superpowers/
skills-lock.json

# Local scratch
tmp/

# Stray screenshots dropped at the repo root by UI/design sessions.
# Root-scoped (leading slash) so committed images under .claude/artifacts/
# and apps/ are unaffected.
/*.png
/*.jpg
/*.jpeg
