  "dtsPropsFor": {
    "EmptyState": "  /** Use a preset from EMPTY_STATE_CONFIGS. Mutually exclusive with title/icon/description. */\n  preset?: EmptyStateKey;\n  /** Primary message (encouraging, action-oriented). REQUIRED unless `preset` is given. */\n  title?: string;\n  /** Icon component, or an icon key string such as 'file-text' | 'shield-check'. */\n  icon?: LucideIcon | EmptyStateIconKey;\n  /** Additional context rendered below the title. */\n  description?: string;\n  /** Optional action (usually a Button). Required if the preset defines an actionLabel. */\n  action?: React.ReactNode;\n  size?: \"sm\" | \"md\" | \"lg\";\n  className?: string;\n  style?: React.CSSProperties;\n  children?: React.ReactNode;",
